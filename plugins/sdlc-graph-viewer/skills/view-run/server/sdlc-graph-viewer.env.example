# sdlc-graph-viewer configuration — copy next to where you run the server:
#
#   cp sdlc-graph-viewer.env.example sdlc-graph-viewer.env
#   node .../assets/server.mjs          # picks up ./sdlc-graph-viewer.env
#
# or point at it explicitly from anywhere:
#
#   SDLC_GRAPH_VIEWER_ENV=/path/to/sdlc-graph-viewer.env node .../assets/server.mjs
#
# Loaded with Node's native process.loadEnvFile — real environment variables
# always beat this file (env > file > default). Every setting is optional.

# Where the project lives (default: the directory you start the server from)
PROJECT_DIR=/abs/path/to/project

# Where the run DIRECTORIES live (default: $PROJECT_DIR/docs/graph-runs).
# Each run is one directory: <run-id>/state.json plus <run-id>/journals/milestone-N.jsonl.
#RUNS_DIR=/abs/path/to/project/docs/graph-runs
#
# SDLC_DIR is still honoured as an alias so an existing env file keeps working — and it is the
# only way to reach a run left over from the flat docs/sdlc/<run-id>-state.json layout, which is
# no longer discovered.

# Fixed port (default: a stable per-project port derived from PROJECT_DIR —
# same project, same port, every time; one server per project, never shared)
#PORT=8477

# How often the pages poll the state JSON, in ms (default: 1000).
# Polling never stops — even after the run reaches DONE.
#POLL_MS=1000

# Bind address (default: 127.0.0.1 — localhost only, since state files are
# not for LAN reading; set 0.0.0.0 only if you deliberately want to expose it)
#HOST=127.0.0.1

# The viewer page served at / and /view (default: the bundled ../viewer/run-viewer.html).
# Leave it unset unless you are deliberately serving a viewer from somewhere else — the default
# is the one copy that ships with this plugin, and the server refuses to start if it cannot read
# whatever this resolves to.
#VIEWER_HTML=/abs/path/to/run-viewer.html

# Derived-port parameters (default: base 8400, range 400, 20 busy-port retries)
#PORT_BASE=8400
#PORT_RANGE=400
#PORT_RETRIES=20
